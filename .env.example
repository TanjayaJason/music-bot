# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia server; jangan gunakan awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio — model embedding gratis yang dipilih secara eksplisit
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq Console — aplikasi tidak beralih otomatis ke model berbayar
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Batas konservatif untuk Vercel Hobby dan Supabase Free
MAX_UPLOAD_MB=8
PUBLIC_CHAT_REQUESTS_PER_HOUR=20
